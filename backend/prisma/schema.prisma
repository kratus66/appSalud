// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Modelo de Institución (Multi-Tenant)
model Institution {
  id        String   @id @default(uuid())
  name      String
  code      String   @unique
  type      String   @default("CLINIC") // CLINIC, HOSPITAL, LAB, OTHER
  status    String   @default("ACTIVE")

  // Datos de contacto
  address   String?
  city      String?
  country   String  @default("CO")
  phone     String?
  email     String?

  // Metadata (JSON almacenado como String)
  metadata  String?
  
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  
  // Relaciones
  users          User[]
  auditEvents    AuditEvent[]
  services       Service[]
  shifts         Shift[]
  contracts      Contract[]
  holidays       Holiday[]
  specialties    Specialty[]
  doctorProfiles DoctorProfile[]
  doctorSchedules DoctorSchedule[]
  timeBlocks     TimeBlock[]
  subscriptions  Subscription[]
  workSchedules  WorkSchedule[]
  
  @@map("institutions")
}

// Plan de Suscripción SaaS
model SubscriptionPlan {
  id          String   @id @default(uuid())
  name        String   @unique
  price       Float
  maxUsers    Int      @map("max_users")
  maxDoctors  Int      @map("max_doctors")
  maxPatients Int      @map("max_patients")

  // Características adicionales (JSON)
  features    String?

  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Relaciones
  subscriptions Subscription[]

  @@map("subscription_plans")
}

// Suscripción de una institución a un plan
model Subscription {
  id            String   @id @default(uuid())

  institutionId String   @map("institution_id")
  institution   Institution @relation(fields: [institutionId], references: [id])

  planId        String   @map("plan_id")
  plan          SubscriptionPlan @relation(fields: [planId], references: [id])

  startDate     DateTime @map("start_date")
  endDate       DateTime? @map("end_date")

  // ACTIVE | CANCELLED | EXPIRED | TRIAL
  status        String   @default("TRIAL")

  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([institutionId])
  @@index([planId])
  @@map("subscriptions")
}

// Modelo de Usuario
model User {
  id            String   @id @default(uuid())
  email         String   @unique
  password      String
  firstName     String
  lastName      String
  role          String
  
  // Multi-tenant field (null para SUPER_ADMIN)
  institutionId String?  @map("institution_id")
  institution   Institution? @relation(fields: [institutionId], references: [id])
  
  // Specialty (for DOCTOR role)
  specialty     String?

  // Security fields
  isActive      Boolean  @default(true)
  failedLoginAttempts Int @default(0)
  lockedUntil   DateTime?
  lastLogin     DateTime?
  
  // Soft delete
  deletedAt     DateTime?
  
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  
  // Relaciones
  refreshTokens      RefreshToken[]
  auditEvents        AuditEvent[]
  doctorAppointments Appointment[]   @relation("DoctorAppointments")
  doctorProfile      DoctorProfile?
  doctorSchedules    DoctorSchedule[]
  timeBlocks         TimeBlock[]
  recurringAppointmentsAsDoctor RecurringAppointment[] @relation("RecurringDoctor")
  // Sprint 8 - Mallas de Turnos
  shiftAssignments     ShiftAssignment[]    @relation("UserAssignments")
  workSchedulesCreated WorkSchedule[]       @relation("WorkScheduleCreator")
  workSchedulesApproved WorkSchedule[]      @relation("WorkScheduleApprover")
  scheduleViolations   ScheduleViolation[]  @relation("UserViolations")
  
  @@index([institutionId])
  // Índices compuestos para queries frecuentes
  @@index([institutionId, role, isActive])
  @@index([email, isActive])
  @@index([role, isActive, deletedAt])
  @@map("users")
}

// Modelo de Refresh Token
model RefreshToken {
  id        String   @id @default(uuid())
  token     String   @unique
  userId    String   @map("user_id")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  expiresAt DateTime
  createdAt DateTime @default(now())
  
  @@index([userId])
  @@map("refresh_tokens")
}

// Modelo de Auditoría (INMUTABLE)
model AuditEvent {
  id            String   @id @default(uuid())
  eventType     String   @map("event_type")
  
  // Usuario que ejecuta la acción
  userId        String?  @map("user_id")
  user          User?    @relation(fields: [userId], references: [id])
  
  // Contexto institucional
  institutionId String?  @map("institution_id")
  institution   Institution? @relation(fields: [institutionId], references: [id])
  
  // Detalles del evento (JSON almacenado como String)
  entityType    String?  @map("entity_type")
  entityId      String?  @map("entity_id")
  details       String?
  
  // Metadata de seguridad
  ipAddress     String?  @map("ip_address")
  userAgent     String?  @map("user_agent")
  
  createdAt     DateTime @default(now())
  
  @@index([eventType])
  @@index([userId])
  @@index([institutionId])
  @@index([createdAt])
  // Índices compuestos para queries de auditoría
  @@index([institutionId, eventType, createdAt])
  @@index([userId, createdAt])
  @@index([institutionId, createdAt])
  @@map("audit_events")
}

// Modelo de Servicio Hospitalario (Sprint 2)
model Service {
  id            String   @id @default(uuid())
  name          String
  description   String?
  
  // Multi-tenant
  institutionId String   @map("institution_id")
  institution   Institution @relation(fields: [institutionId], references: [id])
  
  isActive      Boolean  @default(true)
  deletedAt     DateTime?
  
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  
  @@unique([name, institutionId])
  @@index([institutionId])
  @@map("services")
}

// Modelo de Turno Clínico (Sprint 2)
model Shift {
  id            String   @id @default(uuid())
  name          String
  startTime     String   @map("start_time") // Formato "HH:MM"
  endTime       String   @map("end_time")   // Formato "HH:MM"
  shiftType     String   @map("shift_type") // MORNING, AFTERNOON, NIGHT_6H, NIGHT_12H, DAY_OFF, SPECIAL
  color         String   @default("#3b82f6")
  
  // Multi-tenant
  institutionId String   @map("institution_id")
  institution   Institution @relation(fields: [institutionId], references: [id])
  
  isActive      Boolean  @default(true)

  shiftAssignments ShiftAssignment[]
  
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  
  @@unique([name, institutionId])
  @@index([institutionId])
  @@map("shifts")
}

// Modelo de Contrato Laboral (Sprint 2)
model Contract {
  id                    String   @id @default(uuid())
  name                  String
  weeklyHours           Int      @map("weekly_hours")
  maxConsecutiveNights  Int      @map("max_consecutive_nights")
  requiredRestHours     Int      @map("required_rest_hours")
  
  // Reglas adicionales (JSON almacenado como String)
  rulesConfig           String?  @map("rules_config")
  
  // Multi-tenant
  institutionId         String   @map("institution_id")
  institution           Institution @relation(fields: [institutionId], references: [id])
  
  isActive              Boolean  @default(true)
  
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt
  
  @@unique([name, institutionId])
  @@index([institutionId])
  @@map("contracts")
}

// Modelo de Festivos (Sprint 2)
model Holiday {
  id            String   @id @default(uuid())
  holidayDate   DateTime @map("holiday_date")
  name          String
  countryCode   String   @default("CO") @map("country_code")
  
  // Multi-tenant (null = festivo nacional aplicable a todos)
  institutionId String?  @map("institution_id")
  institution   Institution? @relation(fields: [institutionId], references: [id])
  
  createdAt     DateTime @default(now())
  
  @@index([institutionId])
  @@index([holidayDate])
  @@map("holidays")
}

// Modelo de Especialidad Médica
model Specialty {
  id            String   @id @default(uuid())
  name          String
  description   String?
  color         String   @default("#3b82f6")
  
  // Multi-tenant
  institutionId String   @map("institution_id")
  institution   Institution @relation(fields: [institutionId], references: [id])
  
  isActive      Boolean  @default(true)
  deletedAt     DateTime?
  
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  
  // Relaciones
  doctors       DoctorProfile[]
  
  @@unique([name, institutionId])
  @@index([institutionId])
  @@map("specialties")
}

// Perfil de Médico (1:1 con User de rol DOCTOR)
model DoctorProfile {
  id              String   @id @default(uuid())
  
  // 1:1 con User
  userId          String   @unique @map("user_id")
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  // Especialidad
  specialtyId     String   @map("specialty_id")
  specialty       Specialty @relation(fields: [specialtyId], references: [id])
  
  // Información profesional
  licenseNumber   String?  @map("license_number")   // Nro. tarjeta profesional
  phone           String?
  consultingRoom  String?  @map("consulting_room")  // Consultorio
  bio             String?                            // Resumen profesional
  
  // Horario de atención (JSON almacenado como String)
  scheduleConfig  String?  @map("schedule_config")
  
  // Multi-tenant
  institutionId   String   @map("institution_id")
  institution     Institution @relation(fields: [institutionId], references: [id])
  
  isActive        Boolean  @default(true)
  deletedAt       DateTime?
  
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  
  @@index([institutionId])
  @@index([specialtyId])
  @@map("doctor_profiles")
}

// Modelo de Paciente (Sprint 3)
model Patient {
  id                String   @id @default(uuid())
  firstName         String   @map("first_name")
  lastName          String   @map("last_name")
  documentType      String   @map("document_type") // CC, TI, CE, PA
  documentNumber    String   @map("document_number")
  email             String?
  phone             String?
  birthDate         DateTime? @map("birth_date")
  gender            String?
  address           String?
  
  // Multi-tenant
  institutionId     String   @map("institution_id")
  
  // Metadata adicional (JSON)
  metadata          String?
  
  isActive          Boolean  @default(true)
  deletedAt         DateTime?
  
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  
  // Relaciones
  appointments      Appointment[]
  recurringAppointments RecurringAppointment[] @relation("RecurringPatient")
  
  @@unique([documentNumber, institutionId])
  @@index([institutionId])
  @@index([documentNumber])
  // Índice compuesto para búsquedas de pacientes activos
  @@index([institutionId, isActive, deletedAt])
  @@map("patients")
}

// Modelo de Cita Médica (Sprint 3)
model Appointment {
  id            String   @id @default(uuid())
  
  // Relación con paciente
  patientId     String   @map("patient_id")
  patient       Patient  @relation(fields: [patientId], references: [id])
  
  // Relación con médico (User con rol DOCTOR)
  doctorId      String   @map("doctor_id")
  doctor        User     @relation("DoctorAppointments", fields: [doctorId], references: [id])
  
  // Multi-tenant
  institutionId String   @map("institution_id")
  
  // Fecha y hora de la cita
  appointmentDate    DateTime @map("appointment_date")
  startTime          String   @map("start_time") // Formato "HH:MM"
  endTime            String   @map("end_time")   // Formato "HH:MM"
  
  // Detalles de la cita
  reason        String?  // Motivo de la consulta (opcional)
  notes         String?  // Observaciones del médico
  
  // Estado de la cita
  status        String   @default("SCHEDULED") // SCHEDULED, CONFIRMED, COMPLETED, CANCELLED, NO_SHOW
  
  // Cita recurrente origen (opcional)
  recurringAppointmentId String? @map("recurring_appointment_id")
  recurringAppointment   RecurringAppointment? @relation(fields: [recurringAppointmentId], references: [id])
  
  // Metadata adicional
  metadata      String?
  
  // Soft delete
  deletedAt     DateTime?
  
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  
  @@index([patientId])
  @@index([doctorId])
  @@index([institutionId])
  @@index([appointmentDate])
  @@index([status])
  @@index([recurringAppointmentId])
  // Índices compuestos para queries frecuentes
  @@index([institutionId, appointmentDate, status])
  @@index([doctorId, appointmentDate, status])
  @@index([patientId, appointmentDate])
  @@index([institutionId, status, appointmentDate])
  @@map("appointments")
}

// ────────────────────────────────────────────────────────────────
// Sprint 4 - Disponibilidad y Horarios
// ────────────────────────────────────────────────────────────────

// Horario laboral del médico por día de semana
model DoctorSchedule {
  id            String   @id @default(uuid())
  
  doctorId      String   @map("doctor_id")
  doctor        User     @relation(fields: [doctorId], references: [id], onDelete: Cascade)
  
  // 0=Dom 1=Lun 2=Mar 3=Mié 4=Jue 5=Vie 6=Sáb
  dayOfWeek     Int      @map("day_of_week")
  
  startTime     String   @map("start_time")  // "HH:MM"
  endTime       String   @map("end_time")    // "HH:MM"
  
  // Duración del slot en minutos (default 30)
  slotDuration  Int      @default(30) @map("slot_duration")
  
  institutionId String   @map("institution_id")
  institution   Institution @relation(fields: [institutionId], references: [id])
  
  isActive      Boolean  @default(true)
  
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  
  @@unique([doctorId, dayOfWeek])
  @@index([doctorId])
  @@index([institutionId])
  // Índice compuesto para búsqueda de horarios activos por doctor
  @@index([doctorId, isActive])
  @@index([institutionId, isActive])
  @@map("doctor_schedules")
}

// Bloqueo de agenda (vacaciones, reuniones, etc.)
model TimeBlock {
  id            String   @id @default(uuid())
  
  doctorId      String   @map("doctor_id")
  doctor        User     @relation(fields: [doctorId], references: [id], onDelete: Cascade)
  
  // Fecha del bloqueo
  date          DateTime
  startTime     String   @map("start_time") // "HH:MM"  (null = todo el día)
  endTime       String   @map("end_time")   // "HH:MM"
  
  reason        String?
  
  institutionId String   @map("institution_id")
  institution   Institution @relation(fields: [institutionId], references: [id])
  
  createdAt     DateTime @default(now())
  
  @@index([doctorId])
  @@index([date])
  @@index([institutionId])
  // Índice compuesto para búsqueda de bloqueos por doctor y fecha
  @@index([doctorId, date])
  @@index([institutionId, date])
  @@map("time_blocks")
}

// Cita recurrente (terapia semanal, control mensual, etc.)
model RecurringAppointment {
  id            String   @id @default(uuid())
  
  patientId     String   @map("patient_id")
  patient       Patient  @relation("RecurringPatient", fields: [patientId], references: [id])
  
  doctorId      String   @map("doctor_id")
  doctor        User     @relation("RecurringDoctor", fields: [doctorId], references: [id])
  
  // Día de la semana que aplica la recurrencia
  dayOfWeek     Int      @map("day_of_week")
  startTime     String   @map("start_time")
  endTime       String   @map("end_time")
  
  // WEEKLY | BIWEEKLY | MONTHLY
  frequency     String
  
  reason        String?
  
  startDate     DateTime @map("start_date")
  endDate       DateTime? @map("end_date")
  
  institutionId String   @map("institution_id")
  
  isActive      Boolean  @default(true)
  
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  
  // Citas generadas sinteradas
  appointments  Appointment[]
  
  @@index([patientId])
  @@index([doctorId])
  @@index([institutionId])
  @@map("recurring_appointments")
}

// ─── Sprint 8: Mallas de Turnos ───────────────────────────────────────────────

// Período de programación (semanal, quincenal o mensual)
model WorkSchedule {
  id            String   @id @default(uuid())
  name          String
  // WEEKLY | BIWEEKLY | MONTHLY
  periodType    String   @map("period_type")
  startDate     DateTime @map("start_date")
  endDate       DateTime @map("end_date")
  // DRAFT | PENDING_APPROVAL | APPROVED | REJECTED
  status        String   @default("DRAFT")
  version       Int      @default(1)
  notes         String?
  rejectReason  String?  @map("reject_reason")

  institutionId String   @map("institution_id")
  institution   Institution @relation(fields: [institutionId], references: [id])

  createdById   String   @map("created_by_id")
  createdBy     User     @relation("WorkScheduleCreator", fields: [createdById], references: [id])

  approvedById  String?  @map("approved_by_id")
  approvedBy    User?    @relation("WorkScheduleApprover", fields: [approvedById], references: [id])

  approvedAt    DateTime? @map("approved_at")

  assignments   ShiftAssignment[]
  violations    ScheduleViolation[]

  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([institutionId])
  @@index([status])
  @@index([startDate, endDate])
  @@map("work_schedules")
}

// Asignación de un turno a un trabajador en un día específico
model ShiftAssignment {
  id            String   @id @default(uuid())

  scheduleId    String   @map("schedule_id")
  schedule      WorkSchedule @relation(fields: [scheduleId], references: [id], onDelete: Cascade)

  userId        String   @map("user_id")
  user          User     @relation("UserAssignments", fields: [userId], references: [id])

  assignmentDate DateTime @map("assignment_date")

  // Tipo de turno: MORNING, AFTERNOON, NIGHT_6H, NIGHT_12H, DAY_OFF, SPECIAL
  shiftType     String   @map("shift_type")

  // FK opcional al catálogo de turnos configurado por la institución
  shiftId       String?  @map("shift_id")
  shift         Shift?   @relation(fields: [shiftId], references: [id])

  // Hora de inicio y fin (override sobre la hora predeterminada del shiftType)
  startTime     String?  @map("start_time") // "HH:MM"
  endTime       String?  @map("end_time")   // "HH:MM"

  // Horas efectivas calculadas automáticamente según shiftType
  hoursWorked   Float    @default(0) @map("hours_worked")

  notes         String?

  institutionId String   @map("institution_id")

  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@unique([scheduleId, userId, assignmentDate])
  @@index([scheduleId])
  @@index([userId])
  @@index([assignmentDate])
  @@index([shiftId])
  @@map("shift_assignments")
}

// Violaciones detectadas por el motor de validación
model ScheduleViolation {
  id            String   @id @default(uuid())

  scheduleId    String   @map("schedule_id")
  schedule      WorkSchedule @relation(fields: [scheduleId], references: [id], onDelete: Cascade)

  // Tipos: WEEKLY_HOURS | MAX_CONSECUTIVE | REST_AFTER_NIGHT | MIN_COVERAGE | DUPLICATE_NIGHT
  violationType String   @map("violation_type")
  severity      String   @default("ERROR") // ERROR | WARNING

  // Día afectado (puede ser nulo para violaciones globales)
  affectedDate  DateTime? @map("affected_date")

  // Trabajador afectado (puede ser nulo para violaciones de cobertura)
  affectedUserId String?  @map("affected_user_id")
  affectedUser   User?    @relation("UserViolations", fields: [affectedUserId], references: [id])

  message       String
  suggestion    String?

  institutionId String   @map("institution_id")

  createdAt     DateTime @default(now())

  @@index([scheduleId])
  @@index([violationType])
  @@map("schedule_violations")
}
